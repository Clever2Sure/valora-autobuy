# .env (DO NOT COMMIT to git)
# KITE AI Testnet Configuration
KITE_RPC_URL=https://rpc-testnet.gokite.ai/
KITE_CHAIN_ID=2368
KITE_BLOCK_EXPLORER=https://testnet.kitescan.ai/

# USDT Token on KITE AI Testnet (for payment settlement)
USDT_ADDRESS=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63

# Valora AutoBuy Treasury Address (receives all service charges)
# Use the full receiving wallet address, not the shortened display form like 0xDd1B8...787f1
VALORA_TREASURY_ADDRESS=0xDd1B81c0e23afb7a0307F5c03ad4b6a0b40787f1

# KITE Native Token (for gas fees)
# KITE Token Address (if needed): Will be provided by KITE

# Your Private Key (from MetaMask/Your Wallet)
# WARNING: Keep this secure! Extract from MetaMask: Settings > Security & Privacy > Show Private Key
PRIVATE_KEY=<your-test-wallet-private-key>

# AutoBuy Contract Address (after deployment on KITE)
AUTO_BUY_CONTRACT_ADDRESS=<will-be-provided-after-deploy>

# JWT & Database
JWT_SECRET=your-super-secret-jwt-key-change-this
DATABASE_URL=postgresql://user:password@localhost:5432/autobuy_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=True

# KITE Testnet Faucet for Test Tokens
KITE_FAUCET_URL=https://faucet.gokite.ai

